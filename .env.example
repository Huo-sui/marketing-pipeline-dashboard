DATABASE_URL=postgresql://marketing:marketing@127.0.0.1:5432/marketing_pipeline?schema=public
MARKETING_PIPELINE_DATA_DIR=./data/runtime
MARKETING_PIPELINE_PORT=3210
# Optional. When omitted, the first workspace in PostgreSQL is used.
MARKETING_PIPELINE_WORKSPACE_ID=

# The installer downloads Android Platform Tools into data/toolchain. Override
# these only when using an existing Android SDK or a remote Appium server.
ANDROID_HOME=./data/toolchain/android-sdk
ANDROID_SDK_ROOT=./data/toolchain/android-sdk
ADB_PATH=
APPIUM_URL=http://127.0.0.1:4723/wd/hub

# Zhipu AutoGLM-Phone. Secrets are read by the local Control API only and are
# never returned to the browser or stored in PostgreSQL.
ZHIPU_API_KEY=
ZHIPU_AUTOGLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
ZHIPU_AUTOGLM_MODEL=autoglm-phone

# Optional platform HTTP discovery adapters. Each service exposes
# POST /discover with { platform, terms } and returns { posts, logs } using
# the normalized SourcePost contract. Keep credentials in the adapter service.
# Optional real comment-collection service. It must expose POST /comments and
# return normalized { comments, logs }; no bundled XHS comment bot is included.
XIAOHONGSHU_COMMENT_BOT_BASE_URL=
XIAOHONGSHU_COMMENT_BOT_KEY=
# Optional local phone-publishing service. It must bind to a loopback address,
# expose POST /publish, honor Idempotency-Key, and return a normalized receipt.
XIAOHONGSHU_PUBLISHER_BASE_URL=
XIAOHONGSHU_PUBLISHER_KEY=
DOUYIN_API_BASE_URL=
DOUYIN_API_KEY=
REDDIT_API_BASE_URL=
REDDIT_API_KEY=
X_API_BASE_URL=
X_API_KEY=
INSTAGRAM_API_BASE_URL=
INSTAGRAM_API_KEY=
